import matplotlib.pyplot as plt

x1, y1 = 4, 8
x2, y2 = 12, 6

dx = abs(x2 - x1)
dy = abs(y2 - y1)

x, y = x1, y1
points = []

p = 2 * dy - dx

for i in range(dx + 1):
    points.append((x, y))

    if p < 0:
        p += 2 * dy
    else:
        y -= 1
        p += 2 * dy - 2 * dx

    x += 1

px, py = zip(*points)

plt.plot(px, py, 'o-')
plt.xlabel("X-axis")
plt.ylabel("Y-axis")
plt.title("Bresenham Line Drawing Algorithm")
plt.grid()
plt.show()
