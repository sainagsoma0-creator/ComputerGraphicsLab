FRUIT_TYPES = ["apple", "orange", "lemon", "peach", "kiwi", "banana", "strawberry", "pineapple", "mango"]


def make_fruit_polygon(kind, cx, cy, scale):
    pts = []

    if kind == "watermelon":
        # Wedge-shaped slice
        for i in range(11):
            ang = math.pi * i / 10
            pts.append((
                cx + math.cos(ang) * 65 * scale,
                cy - math.sin(ang) * 55 * scale
            ))
        for i in range(10, -1, -1):
            ang = math.pi * i / 10
            pts.append((
                cx + math.cos(ang) * 54 * scale,
                cy - math.sin(ang) * 44 * scale
            ))
    elif kind == "banana":
        # Curved banana silhouette.
        for i in range(17):
            t = i / 16
            x = -58 + 116 * t
            y = -22 * math.sin(math.pi * t) - 10 * (t - 0.5)
            pts.append((cx + x * scale, cy + y * scale - 14 * scale))
        for i in range(16, -1, -1):
            t = i / 16
            x = -52 + 104 * t
            y = -2 * math.sin(math.pi * t) + 12 * (t - 0.5)
            pts.append((cx + x * scale, cy + y * scale + 14 * scale))
    elif kind == "strawberry":
        # Heart/cone shaped strawberry.
        for i in range(21):
            a = math.pi * 2 * i / 20
            x = 43 * math.cos(a) * (0.92 + 0.08 * math.cos(a))
            y = 48 * math.sin(a)
            if y < 0:
                y *= 0.82
            pts.append((cx + x * scale, cy + y * scale))
        # Narrow the bottom into the strawberry point.
        pts[-1] = (cx, cy + 57 * scale)
    elif kind == "pineapple":
        # Oval pineapple body.
        n = 18
        for i in range(n):
            a = 2 * math.pi * i / n
            r = 47 * scale * (1 + 0.06 * math.sin(3*a))
            pts.append((cx + r * math.cos(a), cy + r * math.sin(a) * 1.18))
    elif kind == "mango":
        # Asymmetric mango silhouette.
        n = 18
        for i in range(n):
            a = 2 * math.pi * i / n
            r = 49 * scale * (1 + 0.16 * math.cos(a - 0.55))
            pts.append((cx + r * math.cos(a), cy + r * math.sin(a) * 1.05))
    else:
        n = 16
        for i in range(n):
            a = 2 * math.pi * i / n

            if kind == "apple":
                r = 53 * scale * (1 + 0.10 * math.sin(2 * a) - 0.06 * math.cos(3 * a))
                x = cx + r * math.cos(a)
                y = cy + r * math.sin(a)
                if y < cy:
                    y -= 4 * scale * math.cos(a)
            elif kind == "orange":
                r = 48 * scale * (1 + 0.025 * math.sin(7 * a))
                x = cx + r * math.cos(a)
                y = cy + r * math.sin(a)
            elif kind == "lemon":
                x = cx + 68 * scale * math.cos(a)
                y = cy + 43 * scale * math.sin(a)
            elif kind == "peach":
                r = 51 * scale * (1 + 0.08 * math.cos(a))
                x = cx + r * math.cos(a)
                y = cy + r * math.sin(a)
            else:  # kiwi
                x = cx + 49 * scale * math.cos(a)
                y = cy + 49 * scale * math.sin(a)

            pts.append((x, y))

    return pts


def fruit_colors(kind):
    return {
        "apple": ((190, 35, 45), (235, 75, 80), (110, 20, 25)),
        "orange": ((235, 125, 20), (255, 175, 55), (150, 70, 10)),
        "watermelon": ((30, 160, 75), (255, 85, 100), (20, 80, 40)),
        "lemon": ((245, 205, 35), (255, 235, 100), (180, 135, 10)),
        "peach": ((240, 125, 90), (255, 175, 140), (170, 70, 60)),
        "kiwi": ((100, 155, 45), (155, 195, 85), (55, 90, 30)),
        "banana": ((235, 195, 35), (255, 235, 105), (145, 105, 15)),
        "strawberry": ((205, 35, 48), (255, 105, 105), (125, 20, 28)),
        "pineapple": ((205, 155, 35), (245, 205, 80), (115, 80, 15)),
        "mango": ((225, 125, 25), (255, 190, 70), (150, 65, 12)),
    }[kind]


def draw_fruit(surface, fruit, polygon=None, offset=(0, 0), clipped_rect=None):
    """Layered procedural fruit renderer using the project's CG algorithms."""
    kind = fruit.kind
    if polygon is None:
        polygon = fruit.polygon
    ox, oy = offset
    poly = [(x + ox, y + oy) for x, y in polygon]
    if clipped_rect:
        poly = polygon_clip(poly, clipped_rect)
    if len(poly) < 3:
        return

    outer, highlight, dark = fruit_colors(kind)
    cx, cy = polygon_centroid(poly)

    # Main body: scan-line fill.
    scanline_fill(surface, poly, outer)

    # Layered shading clipped to the fruit polygon.
    for factor, color in (
        (0.92, tuple(min(255, int(c * 1.06)) for c in outer)),
        (0.82, tuple(max(0, int(c * 0.86)) for c in outer)),
    ):
        inner = [(cx + (x-cx)*factor, cy + (y-cy)*factor) for x, y in poly]
        scanline_fill(surface, inner, color)

    # Broad center layer.
    inner = [(cx + (x-cx)*0.88, cy + (y-cy)*0.86) for x, y in poly]
    scanline_fill(surface, inner, outer)

    # Crisp outline: Bresenham.
    for i in range(len(poly)):
        bresenham_line(surface, poly[i], poly[(i+1) % len(poly)], dark, 3)

    if kind == "watermelon":
        flesh = [(cx+(x-cx)*0.82, cy+(y-cy)*0.80) for x,y in poly]
        scanline_fill(surface, flesh, (239,70,82))
        rind = [(cx+(x-cx)*0.92, cy+(y-cy)*0.90) for x,y in poly]
        pygame.draw.polygon(surface, (104,190,72), rind, 5)
        midpoint_ellipse(surface,cx-20,cy-17,17*fruit.scale,8*fruit.scale,
                          (255,135,145),3)
        random.seed(int(cx*31+cy*17))
        for _ in range(9):
            a=random.uniform(0,math.pi)
            rr=random.uniform(10,32)*fruit.scale
            sx=cx+math.cos(a)*rr; sy=cy-math.sin(a)*rr
            pygame.draw.ellipse(surface,(38,30,27),(round(sx)-3,round(sy)-6,6,12))
        return

    if kind == "apple":
        shadow=[(cx+(x-cx)*0.73+8,cy+(y-cy)*0.73+9) for x,y in poly]
        scanline_fill(surface,shadow,(168,27,36))
        glow=[(cx+(x-cx)*0.66-9,cy+(y-cy)*0.67-10) for x,y in poly]
        scanline_fill(surface,glow,(220,50,58))
        random.seed(int(cx*13+cy*29))
        for _ in range(30):
            a=random.random()*math.pi*2; rr=math.sqrt(random.random())*36*fruit.scale
            sx=cx+math.cos(a)*rr; sy=cy+math.sin(a)*rr
            pygame.draw.circle(surface,(142,32,38),(round(sx),round(sy)),1)
        bresenham_line(surface,(cx,cy-39),(cx+8,cy-61),(75,42,20),5)
        leaf=[(cx+5,cy-54),(cx+31,cy-66),(cx+20,cy-45),(cx+5,cy-49)]
        scanline_fill(surface,leaf,(52,142,56))
        for i in range(4):
            bresenham_line(surface,leaf[i],leaf[(i+1)%4],(28,88,35),2)
        midpoint_ellipse(surface,cx-18,cy-18,14*fruit.scale,22*fruit.scale,
                          (255,175,178),4)
        midpoint_circle(surface,cx-27,cy-29,3,(255,225,225),2)
        return

    if kind == "orange":
        midpoint_circle(surface,cx,cy,47*fruit.scale,(180,72,7),3)
        random.seed(int(cx*19+cy*7))
        for _ in range(90):
            a=random.random()*math.pi*2; rr=math.sqrt(random.random())*40*fruit.scale
            sx=cx+math.cos(a)*rr; sy=cy+math.sin(a)*rr
            pygame.draw.circle(surface,random.choice([(205,91,7),(244,140,25),(255,166,42)]),
                               (round(sx),round(sy)),1)
        midpoint_circle(surface,cx,cy-43*fruit.scale,5,(155,63,6),2)
        midpoint_ellipse(surface,cx-17,cy-18,14*fruit.scale,9*fruit.scale,
                          (255,207,103),4)
        return

    if kind == "lemon":
        midpoint_ellipse(surface,cx,cy,59*fruit.scale,37*fruit.scale,(185,135,7),3)
        random.seed(int(cx*17+cy*23))
        for _ in range(55):
            a=random.random()*math.pi*2
            rx=random.uniform(0,49)*fruit.scale; ry=random.uniform(0,29)*fruit.scale
            sx=cx+math.cos(a)*rx; sy=cy+math.sin(a)*ry
            pygame.draw.circle(surface,(239,190,32),(round(sx),round(sy)),1)
        pygame.draw.polygon(surface,(218,170,19),[
            (cx-57*fruit.scale,cy),(cx-68*fruit.scale,cy-5*fruit.scale),
            (cx-58*fruit.scale,cy+5*fruit.scale)])
        pygame.draw.polygon(surface,(218,170,19),[
            (cx+57*fruit.scale,cy),(cx+68*fruit.scale,cy-5*fruit.scale),
            (cx+58*fruit.scale,cy+5*fruit.scale)])
        midpoint_ellipse(surface,cx-19,cy-17,17*fruit.scale,8*fruit.scale,
                          (255,242,135),4)
        return

    if kind == "peach":
        inner=[(cx+(x-cx)*0.80,cy+(y-cy)*0.80) for x,y in poly]
        scanline_fill(surface,inner,(245,140,105))
        random.seed(int(cx*11+cy*23))
        for _ in range(75):
            a=random.random()*math.pi*2; rr=math.sqrt(random.random())*41*fruit.scale
            sx=cx+math.cos(a)*rr; sy=cy+math.sin(a)*rr
            pygame.draw.circle(surface,random.choice([(221,108,87),(255,165,130),(235,126,99)]),
                               (round(sx),round(sy)),1)
        dda_line(surface,(cx+2,cy-43*fruit.scale),(cx-4,cy+43*fruit.scale),
                 (170,68,60),3)
        midpoint_ellipse(surface,cx-17,cy-19,15*fruit.scale,10*fruit.scale,
                          (255,195,169),4)
        return

    if kind == "kiwi":
        midpoint_circle(surface,cx,cy,50*fruit.scale,(76,54,29),6)
        midpoint_circle(surface,cx,cy,41*fruit.scale,(151,190,75),2)
        midpoint_circle(surface,cx,cy,8*fruit.scale,(229,224,150),2)
        for i in range(18):
            a=i*math.pi*2/18
            dda_line(surface,(cx,cy),
                     (cx+math.cos(a)*35*fruit.scale,cy+math.sin(a)*35*fruit.scale),
                     (181,211,104),1)
        for i in range(20):
            a=i*math.pi*2/20; rr=27*fruit.scale
            midpoint_ellipse(surface,cx+math.cos(a)*rr,cy+math.sin(a)*rr,
                             2.2,4.2,(45,34,23),2)
        midpoint_ellipse(surface,cx-16,cy-18,12*fruit.scale,7*fruit.scale,
                          (211,235,145),3)
        return

    midpoint_ellipse(surface,cx-17,cy-19,13*fruit.scale,8*fruit.scale,highlight,4)


# ------------------------------------------------------------
# Fruit object
# ------------------------------------------------------------

class Fruit:
    def __init__(self):
        self.kind = random.choice(FRUIT_TYPES)
        self.scale = random.uniform(0.85, 1.15)

        self.x = random.randint(100, WIDTH - 100)
        self.y = HEIGHT + random.randint(20, 120)

        self.vx = random.uniform(-2.8, 2.8)
        self.vy = random.uniform(-13.5, -10.0)
        self.gravity = 0.30

        self.rotation = 0
        self.alive = True
        self.sliced = False
        self.slice_timer = 0
        self.piece_data = []

        self.polygon = make_fruit_polygon(
            self.kind, self.x, self.y, self.scale
        )

        self.radius = 65 * self.scale

    def update(self):
        if self.sliced:
            for piece in self.piece_data:
                piece["x"] += piece["vx"]
                piece["y"] += piece["vy"]
                piece["vy"] += 0.22
                piece["angle"] += piece["spin"]
            self.slice_timer -= 1
            if self.slice_timer <= 0:
                self.alive = False
            return

        self.vy += self.gravity
        self.x += self.vx
        self.y += self.vy
        self.rotation += self.vx * 0.5

        self.polygon = make_fruit_polygon(
            self.kind, self.x, self.y, self.scale
        )

        if self.y > HEIGHT + 130:
            self.alive = False

    def draw(self, surface):
        if not self.sliced:
            draw_fruit(surface, self)
            return

        # Draw the two clipped halves.
        for piece in self.piece_data:
            poly = piece["poly"]
            ox, oy = piece["x"] - self.x, piece["y"] - self.y

            draw_fruit(surface, self, polygon=poly, offset=(ox, oy))

    def try_slice(self, a, b):
        if self.sliced:
            return False

        # Quick circular test.
        cx, cy = self.x, self.y
        vx, vy = b[0] - a[0], b[1] - a[1]

        if vx == 0 and vy == 0:
            return False

        t = ((cx - a[0]) * vx + (cy - a[1]) * vy) / (vx * vx + vy * vy)
        t = max(0, min(1, t))
        closest = (a[0] + t * vx, a[1] + t * vy)

        if math.dist((cx, cy), closest) > self.radius:
            return False

        # Actual intersection against the fruit polygon.
        hits = line_polygon_intersections(a, b, self.polygon)

        if len(hits) < 2:
            # If the stroke crosses the visual body but polygon
            # approximation misses, use a robust center test.
            if not point_in_polygon(closest, self.polygon):
                return False

        # Split polygon into two sides of the slicing line.
        line_dx = b[0] - a[0]
        line_dy = b[1] - a[1]

        side_a = []
        side_b = []

        for i in range(len(self.polygon)):
            p = self.polygon[i]
            q = self.polygon[(i + 1) % len(self.polygon)]

            cross_p = line_dx * (p[1] - a[1]) - line_dy * (p[0] - a[0])
            cross_q = line_dx * (q[1] - a[1]) - line_dy * (q[0] - a[0])

            if cross_p >= 0:
                side_a.append(p)
            else:
                side_b.append(p)

            if (cross_p > 0 and cross_q < 0) or (cross_p < 0 and cross_q > 0):
                hit = segment_intersection(p, q, a, b)
                if hit:
                    side_a.append(hit)
                    side_b.append(hit)

        if len(side_a) < 3 or len(side_b) < 3:
            return False

        # Polygon clipping is used again to keep each generated half
        # inside the screen before rendering.
        clip_rect = (0, 0, WIDTH - 1, HEIGHT - 1)
        side_a = polygon_clip(side_a, clip_rect)
        side_b = polygon_clip(side_b, clip_rect)

        if len(side_a) < 3 or len(side_b) < 3:
            return False

        ca = polygon_centroid(side_a)
        cb = polygon_centroid(side_b)

        direction = pygame.Vector2(line_dx, line_dy)
        if direction.length() > 0:
            direction = direction.normalize()

        # Animate the pieces away from the cut.
        self.piece_data = [
            {
                "poly": side_a,
                "x": self.x,
                "y": self.y,
                "vx": -direction.x * 2.5 + self.vx * 0.25,
                "vy": -direction.y * 2.0 + self.vy * 0.20,
                "angle": 0,
                "spin": -0.045,
            },
            {
                "poly": side_b,
                "x": self.x,
                "y": self.y,
                "vx": direction.x * 2.5 + self.vx * 0.25,
                "vy": direction.y * 2.0 + self.vy * 0.20,
                "angle": 0,
                "spin": 0.045,
            }
        ]

        self.sliced = True
        self.slice_timer = 34
        return True


