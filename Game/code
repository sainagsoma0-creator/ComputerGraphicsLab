def put_pixel(surface, x, y, color):
    if 0 <= x < WIDTH and 0 <= y < HEIGHT:
        surface.set_at((int(x), int(y)), color)


def dda_line(surface, p1, p2, color, width=2):
    """DDA line algorithm."""
    x1, y1 = p1
    x2, y2 = p2
    dx, dy = x2 - x1, y2 - y1
    steps = max(abs(dx), abs(dy), 1)
    x_inc = dx / steps
    y_inc = dy / steps
    x, y = x1, y1

    for _ in range(int(steps) + 1):
        pygame.draw.circle(surface, color, (round(x), round(y)), max(1, width // 2))
        x += x_inc
        y += y_inc


def bresenham_line(surface, p1, p2, color, width=2):
    """Bresenham line algorithm."""
    x1, y1 = round(p1[0]), round(p1[1])
    x2, y2 = round(p2[0]), round(p2[1])

    dx = abs(x2 - x1)
    dy = abs(y2 - y1)
    sx = 1 if x1 < x2 else -1
    sy = 1 if y1 < y2 else -1
    err = dx - dy

    radius = max(1, width // 2)

    while True:
        pygame.draw.circle(surface, color, (x1, y1), radius)
        if x1 == x2 and y1 == y2:
            break
        e2 = 2 * err
        if e2 > -dy:
            err -= dy
            x1 += sx
        if e2 < dx:
            err += dx
            y1 += sy


def midpoint_circle(surface, cx, cy, radius, color, width=1):
    """Midpoint circle algorithm."""
    cx, cy, radius = round(cx), round(cy), round(radius)
    x = radius
    y = 0
    decision = 1 - radius

    points = []

    while x >= y:
        points.extend([
            (cx + x, cy + y), (cx + y, cy + x),
            (cx - y, cy + x), (cx - x, cy + y),
            (cx - x, cy - y), (cx - y, cy - x),
            (cx + y, cy - x), (cx + x, cy - y)
        ])
        y += 1
        if decision <= 0:
            decision += 2 * y + 1
        else:
            x -= 1
            decision += 2 * (y - x) + 1

    for p in points:
        if 0 <= p[0] < WIDTH and 0 <= p[1] < HEIGHT:
            pygame.draw.circle(surface, color, p, max(1, width))


def midpoint_ellipse(surface, cx, cy, rx, ry, color, width=1):
    """Midpoint ellipse algorithm."""
    cx, cy, rx, ry = round(cx), round(cy), round(rx), round(ry)
    if rx <= 0 or ry <= 0:
        return

    x, y = 0, ry
    rx2, ry2 = rx * rx, ry * ry
    dx = 2 * ry2 * x
    dy = 2 * rx2 * y

    p1 = ry2 - rx2 * ry + 0.25 * rx2

    points = []

    while dx < dy:
        points += [
            (cx + x, cy + y), (cx - x, cy + y),
            (cx - x, cy - y), (cx + x, cy - y)
        ]
        x += 1
        dx += 2 * ry2

        if p1 < 0:
            p1 += dx + ry2
        else:
            y -= 1
            dy -= 2 * rx2
            p1 += dx - dy + ry2

    p2 = ry2 * (x + 0.5) ** 2 + rx2 * (y - 1) ** 2 - rx2 * ry2

    while y >= 0:
        points += [
            (cx + x, cy + y), (cx - x, cy + y),
            (cx - x, cy - y), (cx + x, cy - y)
        ]
        y -= 1
        dy -= 2 * rx2

        if p2 > 0:
            p2 += rx2 - dy
        else:
            x += 1
            dx += 2 * ry2
            p2 += dx - dy + rx2

    for p in points:
        if 0 <= p[0] < WIDTH and 0 <= p[1] < HEIGHT:
            pygame.draw.circle(surface, color, p, max(1, width))


def scanline_fill(surface, polygon, color):
    """Scan-line polygon filling algorithm."""
    if len(polygon) < 3:
        return

    ys = [p[1] for p in polygon]
    ymin = max(0, math.floor(min(ys)))
    ymax = min(HEIGHT - 1, math.ceil(max(ys)))

    for y in range(ymin, ymax + 1):
        intersections = []

        for i in range(len(polygon)):
            x1, y1 = polygon[i]
            x2, y2 = polygon[(i + 1) % len(polygon)]

            if y1 == y2:
                continue

            if (y >= min(y1, y2)) and (y < max(y1, y2)):
                x = x1 + (y - y1) * (x2 - x1) / (y2 - y1)
                intersections.append(x)

        intersections.sort()

        for i in range(0, len(intersections) - 1, 2):
            x_start = max(0, math.ceil(intersections[i]))
            x_end = min(WIDTH - 1, math.floor(intersections[i + 1]))
            if x_end >= x_start:
                pygame.draw.line(surface, color, (x_start, y), (x_end, y))


def flood_fill(surface, start, fill_color, target_color=None):
    """Stack-based flood fill algorithm."""
    x0, y0 = int(start[0]), int(start[1])
    if not (0 <= x0 < WIDTH and 0 <= y0 < HEIGHT):
        return

    if target_color is None:
        target_color = surface.get_at((x0, y0))[:3]

    if target_color == fill_color:
        return

    # Avoid accidentally flooding the entire screen.
    stack = [(x0, y0)]
    visited = set()

    while stack and len(visited) < 50000:
        x, y = stack.pop()

        if (x, y) in visited or not (0 <= x < WIDTH and 0 <= y < HEIGHT):
            continue

        current = surface.get_at((x, y))[:3]
        if current != target_color:
            continue

        visited.add((x, y))
        surface.set_at((x, y), fill_color)

        stack.extend([(x + 1, y), (x - 1, y), (x, y + 1), (x, y - 1)])


# ------------------------------------------------------------
# Polygon clipping
# ------------------------------------------------------------

def inside_edge(point, edge, rect):
    x, y = point
    left, top, right, bottom = rect

    if edge == "left":
        return x >= left
    if edge == "right":
        return x <= right
    if edge == "top":
        return y >= top
    return y <= bottom


def intersect_edge(a, b, edge, rect):
    x1, y1 = a
    x2, y2 = b
    left, top, right, bottom = rect

    if edge in ("left", "right"):
        x_edge = left if edge == "left" else right
        if x2 == x1:
            return (x_edge, y1)
        t = (x_edge - x1) / (x2 - x1)
        return (x_edge, y1 + t * (y2 - y1))
    else:
        y_edge = top if edge == "top" else bottom
        if y2 == y1:
            return (x1, y_edge)
        t = (y_edge - y1) / (y2 - y1)
        return (x1 + t * (x2 - x1), y_edge)


def sutherland_hodgman_clip(polygon, rect):
    """Sutherland-Hodgman polygon clipping."""
    output = polygon[:]

    for edge in ("left", "right", "top", "bottom"):
        if not output:
            break

        input_list = output
        output = []

        previous = input_list[-1]
        prev_inside = inside_edge(previous, edge, rect)

        for current in input_list:
            cur_inside = inside_edge(current, edge, rect)

            if cur_inside:
                if not prev_inside:
                    output.append(intersect_edge(previous, current, edge, rect))
                output.append(current)
            elif prev_inside:
                output.append(intersect_edge(previous, current, edge, rect))

            previous = current
            prev_inside = cur_inside

    return output


def polygon_clip(polygon, rect):
    """Generic polygon clipping wrapper."""
    return sutherland_hodgman_clip(polygon, rect)


def liang_barsky_clip(p1, p2, rect):
    """Liang-Barsky line clipping algorithm.

    Returns the clipped line or None if it is outside.
    """
    x1, y1 = p1
    x2, y2 = p2
    xmin, ymin, xmax, ymax = rect

    dx = x2 - x1
    dy = y2 - y1

    p = [-dx, dx, -dy, dy]
    q = [x1 - xmin, xmax - x1, y1 - ymin, ymax - y1]

    u1, u2 = 0.0, 1.0

    for pi, qi in zip(p, q):
        if pi == 0:
            if qi < 0:
                return None
        else:
            t = qi / pi
            if pi < 0:
                if t > u2:
                    return None
                u1 = max(u1, t)
            else:
                if t < u1:
                    return None
                u2 = min(u2, t)

    return (
        (x1 + u1 * dx, y1 + u1 * dy),
        (x1 + u2 * dx, y1 + u2 * dy)
    )


