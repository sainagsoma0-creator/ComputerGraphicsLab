class Bomb:
    """Clearly visible animated bomb with line/circle collision."""

    def __init__(self):
        self.x = random.randint(80, WIDTH - 80)
        self.y = HEIGHT + random.randint(20, 100)
        self.vx = random.uniform(-2.5, 2.5)
        self.vy = random.uniform(-13.0, -10.5)
        self.gravity = 0.30
        self.radius = random.randint(38, 46)
        self.alive = True
        self.fuse_time = 0.0

    def update(self):
        self.vy += self.gravity
        self.x += self.vx
        self.y += self.vy
        self.fuse_time += 0.22

        if self.y > HEIGHT + 100:
            self.alive = False

    def draw(self, surface):
        cx, cy = round(self.x), round(self.y)
        r = self.radius

        # Large black bomb body.
        pygame.draw.circle(surface, (12, 12, 15), (cx, cy), r)
        pygame.draw.circle(surface, (45, 45, 50), (cx - 4, cy - 5), r - 6)

        # Glossy highlight.
        pygame.draw.ellipse(
            surface, (105, 105, 112),
            (cx - r*0.55, cy - r*0.58, r*0.30, r*0.22)
        )

        # Strong outer border using midpoint circle.
        midpoint_circle(surface, cx, cy, r, (5, 5, 7), 4)

        # Fuse socket.
        pygame.draw.rect(
            surface, (90, 65, 35),
            (cx - 9, cy - r - 9, 18, 13),
            border_radius=3
        )

        # Fuse using DDA segments.
        fuse = [
            (cx, cy-r-5),
            (cx+5, cy-r-19),
            (cx+16, cy-r-25),
            (cx+22, cy-r-16)
        ]
        for a, b in zip(fuse, fuse[1:]):
            dda_line(surface, a, b, (155, 105, 55), 4)

        # Animated orange/yellow spark.
        sx, sy = fuse[-1]
        pulse = 5 + int(3 * abs(math.sin(self.fuse_time)))
        midpoint_circle(surface, sx, sy, pulse, (255, 150, 25), 3)
        pygame.draw.circle(surface, (255, 240, 120), (sx, sy), max(2, pulse//2))

        # Small warning band makes it unmistakable as a bomb.
        bresenham_line(
            surface, (cx-r//2, cy+r//2),
            (cx+r//2, cy+r//2), (85, 85, 90), 3
        )

    def hit_by_segment(self, a, b):
        dx = b[0] - a[0]
        dy = b[1] - a[1]

        if dx == 0 and dy == 0:
            return False

        t = ((self.x-a[0])*dx + (self.y-a[1])*dy) / (dx*dx + dy*dy)
        t = max(0.0, min(1.0, t))
        closest = (a[0] + t*dx, a[1] + t*dy)

        return math.dist((self.x, self.y), closest) <= self.radius + 8

# ------------------------------------------------------------
# Game state
# ------------------------------------------------------------

fruits = []
bombs = []
score = 0
best_score = 0
lives = 3
spawn_timer = 0
game_over = False

# Combo meter: consecutive fruit slices build the multiplier.
combo = 0
combo_timer = 0
COMBO_WINDOW = 75  # frames before the combo resets
MAX_COMBO = 20


# Mouse slicing trail.
blade_points = []
blade_timer = 0
MAX_BLADE_POINTS = 24

# Particles.
particles = []


def spawn_fruit():
    fruits.append(Fruit())



def register_fruit_slice(pos):
    """Increase combo and award a multiplier-based score."""
    global combo, combo_timer, score

    combo = min(MAX_COMBO, combo + 1)
    combo_timer = COMBO_WINDOW

    # Every slice is worth more while the combo is active.
    multiplier = 1 + combo // 3
    score += 10 * multiplier
    global best_score
    best_score = max(best_score, score)
    add_slice_particles(pos)


def spawn_bomb():
    bombs.append(Bomb())


def add_slice_particles(pos):
    for _ in range(18):
        angle = random.uniform(0, math.pi * 2)
        speed = random.uniform(1.5, 5.0)
        particles.append({
            "x": pos[0],
            "y": pos[1],
            "vx": math.cos(angle) * speed,
            "vy": math.sin(angle) * speed,
            "life": random.randint(15, 28),
            "size": random.randint(2, 5),
        })


def update_particles():
    for p in particles[:]:
        p["x"] += p["vx"]
        p["y"] += p["vy"]
        p["vy"] += 0.10
        p["life"] -= 1

        if p["life"] <= 0:
            particles.remove(p)


def draw_particles(surface):
    for p in particles:
        pygame.draw.circle(
            surface, (255, 230, 130),
            (round(p["x"]), round(p["y"])),
            p["size"]
        )


def reset_game():
    global fruits, bombs, score, lives, spawn_timer, game_over
    fruits = []
    bombs = []
    score = 0
    lives = 3
    spawn_timer = 0
    game_over = False


def draw_background(surface):
    """Warm wooden arcade background inspired by the generated mockup."""
    surface.fill((67, 31, 16))

    # Wooden planks.
    plank_h = 88
    for y in range(0, HEIGHT, plank_h):
        base = 76 + ((y // plank_h) % 2) * 8
        pygame.draw.rect(surface, (base, 39, 20), (0, y, WIDTH, plank_h))

        # Plank grain.
        random.seed(9000 + y)
        for _ in range(12):
            x = random.randint(0, WIDTH)
            length = random.randint(40, 180)
            yy = y + random.randint(12, plank_h - 12)
            dda_line(surface, (x, yy), (min(WIDTH, x + length), yy),
                     (base + 10, 48, 24), 2)

    # Vertical plank seams.
    for x in range(0, WIDTH, 185):
        pygame.draw.rect(surface, (43, 22, 13), (x, 0, 5, HEIGHT))
        pygame.draw.rect(surface, (104, 53, 27), (x + 5, 0, 2, HEIGHT))

    # A few dark scratches.
    random.seed(12345)
    for _ in range(22):
        x = random.randint(0, WIDTH)
        y = random.randint(90, HEIGHT - 10)
        length = random.randint(20, 75)
        bresenham_line(surface, (x, y), (x + length, y - random.randint(4, 18)),
                        (52, 25, 14), 2)

    # Subtle top vignette.
    overlay = pygame.Surface((WIDTH, 95), pygame.SRCALPHA)
    overlay.fill((0, 0, 0, 70))
    surface.blit(overlay, (0, 0))


def draw_hud(surface):
    # Left score panel.
    score_label = SMALL_BOLD.render("SCORE", True, (255, 225, 70))
    score_value = SCORE_FONT.render(str(score), True, (255, 245, 125))
    best_value = SMALL_BOLD.render(f"BEST: {max(best_score, score)}", True, (255, 225, 70))

    surface.blit(score_label, (30, 20))
    surface.blit(score_value, (28, 40))
    surface.blit(best_value, (30, 82))

    # Center combo.
    multiplier = 1 + combo // 3 if combo > 0 else 1
    combo_title = COMBO_FONT.render(
        f"COMBO   x{multiplier}", True, (255, 224, 70)
    )
    surface.blit(combo_title,
                 (WIDTH//2 - combo_title.get_width()//2, 18))

    bar_w, bar_h = 350, 18
    bar_x = WIDTH//2 - bar_w//2
    bar_y = 55
    pygame.draw.rect(surface, (35, 20, 12),
                     (bar_x-4, bar_y-4, bar_w+8, bar_h+8),
                     border_radius=10)
    pygame.draw.rect(surface, (90, 55, 20),
                     (bar_x, bar_y, bar_w, bar_h),
                     border_radius=9)

    fill_ratio = combo_timer / COMBO_WINDOW if combo > 0 else 0
    fill_w = int(bar_w * fill_ratio)
    if fill_w:
        pygame.draw.rect(surface, (255, 181, 25),
                         (bar_x, bar_y, fill_w, bar_h),
                         border_radius=9)

    if combo > 0:
        streak = SMALL_BOLD.render(
            f"FRUIT STREAK: {combo}", True, (180, 255, 60)
        )
        surface.blit(streak, (WIDTH//2 - streak.get_width()//2, 80))

    # Right-side lives.
    lives_label = SMALL_BOLD.render("LIVES", True, (255, 230, 230))
    surface.blit(lives_label, (WIDTH - 160, 18))

    for i in range(3):
        x = WIDTH - 145 + i * 40
        if i < lives:
            pygame.draw.circle(surface, (220, 35, 45), (x, 57), 15)
            pygame.draw.circle(surface, (255, 90, 95), (x-4, 52), 6)
        else:
            pygame.draw.circle(surface, (70, 35, 35), (x, 57), 15)

    # Bomb warning.
    warning = SMALL_BOLD.render("BOMBS ARE DEADLY!", True, (255, 85, 45))
    surface.blit(warning, (WIDTH - warning.get_width() - 22, 88))

    # Bottom instruction.
    hint = SMALL_BOLD.render(
        "SLICE WITH YOUR MOUSE  •  AVOID BOMBS",
        True, (245, 235, 220)
    )
    surface.blit(hint, (WIDTH//2 - hint.get_width()//2, HEIGHT - 32))


def draw_blade(surface):
    if len(blade_points) < 2:
        return

    # Liang-Barsky clips every blade segment to the screen.
    clipped_segments = []

    for i in range(len(blade_points) - 1):
        clipped = liang_barsky_clip(
            blade_points[i],
            blade_points[i + 1],
            (0, 0, WIDTH - 1, HEIGHT - 1)
        )
        if clipped:
            clipped_segments.append(clipped)

    for a, b in clipped_segments:
        # DDA for the glowing trail.
        dda_line(surface, a, b, (245, 245, 255), 5)
        # Bresenham for the sharp core.
        bresenham_line(surface, a, b, (255, 255, 255), 2)

    if blade_points:
        midpoint_circle(
            surface,
            blade_points[-1][0],
            blade_points[-1][1],
            7,
            (255, 255, 255),
            2
        )


def draw_game_over(surface):
    overlay = pygame.Surface((WIDTH, HEIGHT), pygame.SRCALPHA)
    overlay.fill((0, 0, 0, 160))
    surface.blit(overlay, (0, 0))

    title = BIG.render("GAME OVER", True, (255, 100, 110))
    final = FONT.render(f"Final Score: {score}", True, (245, 245, 245))
    restart = FONT.render("Press R to play again", True, (190, 200, 215))

    surface.blit(title, (WIDTH // 2 - title.get_width() // 2, 260))
    surface.blit(final, (WIDTH // 2 - final.get_width() // 2, 325))
    surface.blit(restart, (WIDTH // 2 - restart.get_width() // 2, 370))


# ------------------------------------------------------------
# Main loop
# ------------------------------------------------------------

running = True
mouse_down = False

while running:
    dt = clock.tick(FPS)

    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

        elif event.type == pygame.KEYDOWN:
            if event.key == pygame.K_ESCAPE:
                running = False

            if event.key == pygame.K_r and game_over:
                reset_game()

        elif event.type == pygame.MOUSEBUTTONDOWN:
            if event.button == 1 and not game_over:
                mouse_down = True
                blade_points = [event.pos]

        elif event.type == pygame.MOUSEBUTTONUP:
            if event.button == 1:
                mouse_down = False

        elif event.type == pygame.MOUSEMOTION:
            if mouse_down and not game_over:
                current = event.pos
                previous = blade_points[-1] if blade_points else current

                # A single mouse motion segment is the actual cutting line.
                if math.dist(previous, current) > 1:
                    blade_points.append(current)
                    if len(blade_points) > MAX_BLADE_POINTS:
                        blade_points.pop(0)

                    # Check bombs against THIS exact mouse segment.
                    for bomb in bombs[:]:
                        if bomb.hit_by_segment(previous, current):
                            lives -= 1
                            add_slice_particles((bomb.x, bomb.y))
                            bombs.remove(bomb)
                            if lives <= 0:
                                game_over = True
                            break

                    # Check every fruit against THIS exact mouse segment.
                    for fruit in fruits:
                        if fruit.try_slice(previous, current):
                            register_fruit_slice(current)

    if not game_over:
        spawn_timer -= 1
        if spawn_timer <= 0:
            spawn_fruit()

            # Bombs deliberately spawn regularly so they are easy to see.
            # First bomb appears quickly, then roughly every few waves.
            if len(bombs) == 0 and random.random() < 0.45:
                spawn_bomb()
            elif random.random() < 0.22:
                spawn_bomb()

            spawn_timer = max(18, random.randint(30, 50) - score // 50)

        for fruit in fruits:
            fruit.update()

        for bomb in bombs:
            bomb.update()

        # Lose a life only if an unsliced fruit falls below the screen.
        for fruit in fruits[:]:
            if not fruit.alive:
                if not fruit.sliced and fruit.y > HEIGHT + 70:
                    lives -= 1

                fruits.remove(fruit)

        # Remove bombs that have fallen off-screen.
        for bomb in bombs[:]:
            if not bomb.alive:
                bombs.remove(bomb)

        if lives <= 0:
            game_over = True

        if combo_timer > 0:
            combo_timer -= 1
            if combo_timer <= 0:
                combo = 0

        update_particles()

    if blade_points:
        blade_timer += 1
        if not mouse_down:
            blade_points = blade_points[-8:]
            for _ in range(min(2, len(blade_points))):
                if blade_points:
                    blade_points.pop(0)

    # Draw.
    draw_background(screen)

    for fruit in fruits:
        fruit.draw(screen)

    for bomb in bombs:
        bomb.draw(screen)

    draw_particles(screen)
    draw_blade(screen)
    draw_hud(screen)

    if game_over:
        draw_game_over(screen)

    pygame.display.flip()

pygame.quit()
