import numpy as np
import matplotlib.pyplot as plt

# Triangle coordinates
P = np.array([[1, 3, 2, 1],
              [1, 1, 3, 1],
              [1, 1, 1, 1]])

# Reflection about X-axis
Ref = np.array([[1, 0, 0],
                [0, -1, 0],
                [0, 0, 1]])

# Shearing along X-axis
Sh = np.array([[1, 1, 0],
               [0, 1, 0],
               [0, 0, 1]])

# Apply transformations
PR = Ref @ P
PS = Sh @ P

# Plot
plt.plot(P[0], P[1], 'o-', label="Original")
plt.plot(PR[0], PR[1], 'o-', label="Reflection")
plt.plot(PS[0], PS[1], 'o-', label="Shearing")

plt.xlabel("X-axis")
plt.ylabel("Y-axis")
plt.grid()
plt.axis("equal")
plt.legend()
plt.show()
