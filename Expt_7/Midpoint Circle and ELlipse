import matplotlib.pyplot as plt

xc, yc = 0, 0
r = 5

x = 0
y = r
p = 1 - r

points = []

while x <= y:
    points += [
        (xc+x, yc+y), (xc-x, yc+y),
        (xc+x, yc-y), (xc-x, yc-y),
        (xc+y, yc+x), (xc-y, yc+x),
        (xc+y, yc-x), (xc-y, yc-x)
    ]

    x += 1

    if p < 0:
        p += 2*x + 1
    else:
        y -= 1
        p += 2*(x-y) + 1

px, py = zip(*points)

plt.scatter(px, py)
plt.axis("equal")
plt.grid()
plt.title("Midpoint Circle Algorithm")
plt.show()
