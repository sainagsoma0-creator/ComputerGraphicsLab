import numpy as np
import matplotlib.pyplot as plt

# Triangle coordinates
P = np.array([[1, 3, 2, 1],
              [1, 1, 3, 1],
              [1, 1, 1, 1]])

# Translation
T = np.array([[1, 0, 2],
              [0, 1, 1],
              [0, 0, 1]])

# Scaling
S = np.array([[2, 0, 0],
              [0, 2, 0],
              [0, 0, 1]])

# Rotation by 90 degrees
R = np.array([[0, -1, 0],
              [1,  0, 0],
              [0,  0, 1]])

# Transformations
PT = T @ P
PS = S @ P
PR = R @ P

# Plot
plt.plot(P[0], P[1], 'o-', label="Original")
plt.plot(PT[0], PT[1], 'o-', label="Translation")
plt.plot(PS[0], PS[1], 'o-', label="Scaling")
plt.plot(PR[0], PR[1], 'o-', label="Rotation")

plt.xlabel("X-axis")
plt.ylabel("Y-axis")
plt.grid()
plt.axis("equal")
plt.legend()
plt.show()
