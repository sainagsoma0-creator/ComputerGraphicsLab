import matplotlib.pyplot as plt

x1, y1 = 2, 3
x2, y2 = 8, 6

dx = x2 - x1
dy = y2 - y1
steps = max(abs(dx), abs(dy))

x_inc = dx / steps
y_inc = dy / steps

x, y = x1, y1
points = []

for i in range(steps + 1):
    points.append((round(x), round(y)))
    x += x_inc
    y += y_inc

x, y = zip(*points)

plt.plot(x, y, 'o-')
plt.xlabel("X-axis")
plt.ylabel("Y-axis")
plt.title("DDA Line Drawing Algorithm")
plt.grid()
plt.show()
