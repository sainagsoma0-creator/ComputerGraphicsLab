import numpy as np
import matplotlib.pyplot as plt

# 3D points
P = np.array([
    [1, 3, 2, 1],
    [1, 1, 3, 1],
    [2, 2, 4, 4]
])

# Perspective projection
x = P[0] / P[2]
y = P[1] / P[2]

plt.scatter(x, y)

for i in range(len(x)):
    plt.text(x[i], y[i], f"({x[i]:.2f}, {y[i]:.2f})")

plt.xlabel("X-axis")
plt.ylabel("Y-axis")
plt.title("Perspective Transformation")
plt.grid()
plt.show()
