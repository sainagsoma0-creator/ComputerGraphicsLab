import numpy as np
import matplotlib.pyplot as plt

# Triangle
P = np.array([[1, 3, 2, 1],
              [1, 1, 3, 1]])

# Rotation by 90 degrees
R = np.array([[0, -1],
              [1,  0]])

# Reflection about X-axis
F = np.array([[1,  0],
              [0, -1]])

rotated = R @ P
reflected = F @ P

plt.plot(P[0], P[1], 'o-', label="Original")
plt.plot(rotated[0], rotated[1], 'o-', label="Rotated 90°")
plt.plot(reflected[0], reflected[1], 'o-', label="Reflected")

plt.xlabel("X-axis")
plt.ylabel("Y-axis")
plt.title("2D Rotation and Reflection")
plt.grid()
plt.axis("equal")
plt.legend()
plt.show()
