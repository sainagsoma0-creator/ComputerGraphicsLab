import matplotlib.pyplot as plt

# Polygon
x = [-1, 3, 5, 4, 1, -1]
y = [1, 5, 2, -2, -1, 1]

# Clipping window
xmin, xmax = 0, 4
ymin, ymax = 0, 4

plt.fill(x, y, alpha=0.4, label="Polygon")

# Clipping window
plt.plot([xmin, xmax, xmax, xmin, xmin],
         [ymin, ymin, ymax, ymax, ymin],
         'k--', label="Clipping Window")

plt.xlabel("X-axis")
plt.ylabel("Y-axis")
plt.title("Polygon Clipping and Antialiasing")
plt.grid()
plt.axis("equal")
plt.legend()
plt.show()
