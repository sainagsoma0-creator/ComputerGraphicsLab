import numpy as np
import matplotlib.pyplot as plt

# Triangle coordinates
P = np.array([[1, 3, 2, 1],
              [1, 1, 3, 1],
              [1, 1, 1, 1]])

# Translation matrix
T = np.array([[1, 0, 2],
              [0, 1, 1],
              [0, 0, 1]])

# Scaling matrix
S = np.array([[2, 0, 0],
              [0, 2, 0],
              [0, 0, 1]])

PT = T @ P
PS = S @ P

plt.plot(P[0], P[1], 'o-', label="Original")
plt.plot(PT[0], PT[1], 'o-', label="Translated")
plt.plot(PS[0], PS[1], 'o-', label="Scaled")

plt.xlabel("X-axis")
plt.ylabel("Y-axis")
plt.title("2D Translation and Scaling")
plt.grid()
plt.axis("equal")
plt.legend()
plt.show()
